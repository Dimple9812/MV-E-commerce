{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/contracts/events/envelope.schema.json",
  "title": "MarketFlow event envelope",
  "description": "Every Kafka message value is one envelope serialized as UTF-8 JSON. The message key is the aggregate id.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateType",
    "aggregateId",
    "occurredAt",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "unique per event; consumers deduplicate on it"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]+$"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "major version of the payload schema"
    },
    "aggregateType": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "request/checkout correlation id propagated across services"
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "eventId of the message that caused this one, if any"
    },
    "producer": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
