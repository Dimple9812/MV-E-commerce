{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/contracts/events/schemas/order.events.RefundRequested.v1.schema.json",
  "title": "RefundRequested v1",
  "description": "Informational: a refund was requested for a cancelled confirmed order.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RefundRequested"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "amount",
        "customerId",
        "orderId",
        "reason"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "customerId": {
          "type": "string",
          "format": "uuid"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "decimal amount in the order currency, 2 fraction digits"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  "x-topic": "order.events",
  "x-producer": "order-service",
  "x-consumers": [
    "notification-service",
    "analytics-service"
  ],
  "x-key": "orderId"
}
