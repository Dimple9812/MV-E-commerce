{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/contracts/events/schemas/inventory.commands.InventoryConfirmationRequested.v1.schema.json",
  "title": "InventoryConfirmationRequested v1",
  "description": "Saga step after capture: turn the reservation into a sale.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "InventoryConfirmationRequested"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "lines",
        "orderId"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "quantity",
              "sku",
              "variantId"
            ],
            "properties": {
              "variantId": {
                "type": "string",
                "format": "uuid"
              },
              "sku": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "minItems": 1
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  "x-topic": "inventory.commands",
  "x-producer": "order-service",
  "x-consumers": [
    "inventory-service"
  ],
  "x-key": "orderId"
}
