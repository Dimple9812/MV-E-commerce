{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/contracts/events/schemas/inventory.events.InventoryReservationFailed.v1.schema.json",
  "title": "InventoryReservationFailed v1",
  "description": "Not enough stock for at least one line; nothing was reserved.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "InventoryReservationFailed"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "reason",
        "unavailable"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string"
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "available",
              "requested",
              "sku",
              "variantId"
            ],
            "properties": {
              "variantId": {
                "type": "string",
                "format": "uuid"
              },
              "sku": {
                "type": "string"
              },
              "requested": {
                "type": "integer"
              },
              "available": {
                "type": "integer"
              }
            }
          },
          "minItems": 0
        }
      }
    }
  },
  "x-topic": "inventory.events",
  "x-producer": "inventory-service",
  "x-consumers": [
    "order-service"
  ],
  "x-key": "orderId (reservation events) or variantId (stock events)"
}
