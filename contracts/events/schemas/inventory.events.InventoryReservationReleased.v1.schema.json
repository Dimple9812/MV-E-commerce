{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/contracts/events/schemas/inventory.events.InventoryReservationReleased.v1.schema.json",
  "title": "InventoryReservationReleased v1",
  "description": "Reserved units returned to available.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "InventoryReservationReleased"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "reservationId",
        "status"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "reservationId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "examples": [
            "CONFIRMED",
            "RELEASED",
            "EXPIRED",
            "RETURNED"
          ],
          "description": "open enumeration: known values CONFIRMED, RELEASED, EXPIRED, RETURNED"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  "x-topic": "inventory.events",
  "x-producer": "inventory-service",
  "x-consumers": [
    "order-service"
  ],
  "x-key": "orderId (reservation events) or variantId (stock events)"
}
