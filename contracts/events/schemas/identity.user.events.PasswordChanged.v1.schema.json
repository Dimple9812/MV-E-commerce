{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketflow.dev/contracts/events/schemas/identity.user.events.PasswordChanged.v1.schema.json",
  "title": "PasswordChanged v1",
  "description": "Password changed or reset; all refresh tokens were revoked.",
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PasswordChanged"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "changedAt",
        "userId"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "x-topic": "identity.user.events",
  "x-producer": "identity-service",
  "x-consumers": [
    "notification-service"
  ],
  "x-key": "userId"
}
