# Copy to .env and replace every change-me value. .env is git-ignored; never commit real secrets.
# Generate values with:  openssl rand -base64 24

# --- PostgreSQL (one database and one login role per service) ---
POSTGRES_PASSWORD=change-me-postgres
IDENTITY_DB_PASSWORD=change-me-identity
VENDOR_DB_PASSWORD=change-me-vendor
CATALOG_DB_PASSWORD=change-me-catalog
INVENTORY_DB_PASSWORD=change-me-inventory
ORDER_DB_PASSWORD=change-me-order
PAYMENT_DB_PASSWORD=change-me-payment
NOTIFICATION_DB_PASSWORD=change-me-notification
REVIEW_DB_PASSWORD=change-me-review
ANALYTICS_DB_PASSWORD=change-me-analytics
CHAT_DB_PASSWORD=change-me-chat

# --- Payments: HMAC secret shared by the sandbox provider and payment-service webhook endpoint ---
PAYMENT_WEBHOOK_SECRET=change-me-whsec

# --- First administrator, created once on an empty identity database (leave blank to skip) ---
BOOTSTRAP_ADMIN_EMAIL=admin@marketflow.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password-12

# --- JWT signing key (PKCS#8 PEM). Empty = ephemeral development key regenerated on each restart. ---
JWT_PRIVATE_KEY_PEM=

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana
TRACING_ENABLED=true
TRACING_SAMPLING=1.0
LOG_FORMAT=logstash

# --- Development-only fault injection for notification retries and dead letters ---
NOTIFICATION_FAULT_INJECTION=true

# Host port for the storefront (http://localhost:<port>); change it if 3000 is already used on your machine.
FRONTEND_HOST_PORT=3000
# Interface the storefront listens on. Keep 127.0.0.1 on a workstation; 0.0.0.0 on a public server.
FRONTEND_BIND=127.0.0.1
